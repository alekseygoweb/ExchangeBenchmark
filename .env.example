# Образец файла с ключами. Скопируйте в .env и заполните своими БОЕВЫМИ ключами:
#   cp .env.example .env
# Файл .env в git НЕ коммитится (см. .gitignore).

# ── Binance (PROD, РЕАЛЬНЫЕ ДЕНЬГИ) ───────────────────────────────────────────
# Один ключ обычно работает и на фьючерсах, и на споте (нужны права на торговлю).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Необязательно: отдельные ключи под фьючерсы/спот.
# Если заданы — имеют приоритет над общими BINANCE_API_KEY/SECRET выше.
# BINANCE_FUTURES_API_KEY=
# BINANCE_FUTURES_API_SECRET=
# BINANCE_SPOT_API_KEY=
# BINANCE_SPOT_API_SECRET=

# ── OKX (PROD, РЕАЛЬНЫЕ ДЕНЬГИ) ───────────────────────────────────────────────
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# ── MEXC (PROD, РЕАЛЬНЫЕ ДЕНЬГИ) ───────────────────────────────────────────────
# Спот работает; фьючерсный order-API MEXC — под maintenance (вернёт code 500).
MEXC_API_KEY=
MEXC_API_SECRET=

# ── Необязательные настройки ──────────────────────────────────────────────────
# Пути к конфигам (по умолчанию config_binance_PROD.json / config_okx_PROD.json):
# CONFIG_BINANCE=config_binance_PROD.json
# CONFIG_OKX=config_okx_PROD.json
# Число повторов цикла "размещение+отмена" (по умолчанию 5):
# LATENCY_REPEATS=5
# Пропустить подтверждение перед торговлей реальными деньгами (1/yes/true):
# LATENCY_CONFIRM=
# Авто-цена: считать безопасную неисполняемую цену от рынка (1/yes/true):
# AUTO_PRICE=1
# Отступ авто-цены от лучшего бида/аска, в процентах (по умолчанию 1.0):
# PRICE_OFFSET=1.0
# Авто-размер: ставить минимальный валидный объём ордера (1/yes/true):
# AUTO_SIZE=1
# Условный (trigger) бенчмарк Binance (1/yes/true) — отдельный конфиг:
# CONDITIONAL=1
# CONFIG_BINANCE_CONDITIONAL=config_binance_PROD_conditional.json
# Balance-guard для условного режима (по умолчанию включён); порог в USDT:
# BALANCE_GUARD=0
# MAX_EQUITY_USDT=50
# Не сверять локальные часы с временем биржи (1/yes/true):
# SKIP_TIME_CHECK=1
