# Образец файла с ключами. Скопируйте в .env и заполните своими БОЕВЫМИ ключами:
#   cp .env.example .env
# Файл .env в git НЕ коммитится (см. .gitignore).

# ── Binance (PROD, РЕАЛЬНЫЕ ДЕНЬГИ) ───────────────────────────────────────────
# Один ключ обычно работает и на фьючерсах, и на споте (нужны права на торговлю).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Необязательно: отдельные ключи под фьючерсы/спот.
# Если заданы — имеют приоритет над общими BINANCE_API_KEY/SECRET выше.
# BINANCE_FUTURES_API_KEY=
# BINANCE_FUTURES_API_SECRET=
# BINANCE_SPOT_API_KEY=
# BINANCE_SPOT_API_SECRET=

# ── OKX (PROD, РЕАЛЬНЫЕ ДЕНЬГИ) ───────────────────────────────────────────────
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# ── Необязательные настройки ──────────────────────────────────────────────────
# Пути к конфигам (по умолчанию config_binance_PROD.json / config_okx_PROD.json):
# CONFIG_BINANCE=config_binance_PROD.json
# CONFIG_OKX=config_okx_PROD.json
# Число повторов цикла "размещение+отмена" (по умолчанию 5):
# LATENCY_REPEATS=5
# Пропустить подтверждение перед торговлей реальными деньгами (1/yes/true):
# LATENCY_CONFIRM=
