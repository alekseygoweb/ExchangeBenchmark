[Unit]
Description=AmneziaWG -> Xray (tun xray0) routing bridge
# Дёргается udev-правилом при появлении xray0 и таймером awg-xray-bridge.timer,
# а также вручную: systemctl start awg-xray-bridge.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/awg-xray-bridge.sh
RemainAfterExit=no
# Если xray0 ещё не готов — не считаем это фатальной ошибкой.
SuccessExitStatus=0

[Install]
WantedBy=multi-user.target
