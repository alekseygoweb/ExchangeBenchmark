[Unit]
Description=Safety-net: periodically re-assert AmneziaWG -> Xray (xray0) bridge
# Страховка на случай, если udev-событие появления xray0 было пропущено, или
# маршрут в таблице 100 слетел по иной причине. Скрипт идемпотентен: если
# xray0 нет — тихо выходит; если есть — гарантирует ip rule + маршрут + FORWARD.

[Timer]
OnBootSec=45
OnUnitActiveSec=30
AccuracySec=5s

[Install]
WantedBy=timers.target
