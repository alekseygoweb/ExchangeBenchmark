+// inboundAwgParams returns the raw AmneziaWG obfuscation object from an
+// amneziawg inbound's settings JSON, so the clients page can render a client
+// .conf whose parameters match the server. It returns "" for other protocols or
+// when no params are present.
+func inboundAwgParams(protocol string, settings string) string {
+	if protocol != string(model.AmneziaWG) || strings.TrimSpace(settings) == "" {
+		return ""
+	}
+	var parsed struct {
+		AWG json.RawMessage `json:"awg"`
+	}
+	if err := json.Unmarshal([]byte(settings), &parsed); err != nil {
+		return ""
+	}
+	trimmed := strings.TrimSpace(string(parsed.AWG))
+	if trimmed == "" || trimmed == "null" {
+		return ""
+	}
+	return trimmed
