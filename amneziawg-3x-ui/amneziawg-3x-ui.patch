+export interface AmneziawgInboundSeed {
+  mtu?: number;
+  secretKey?: string;
+  noKernelTun?: boolean;
+}
+
+// AmneziaWG is WireGuard plus packet obfuscation: a new inbound holds the same
+// server identity (secretKey/mtu) and starts with no clients, plus a randomized
+// `awg` obfuscation object (matching the form's Randomize button) so the tunnel
+// diverges from a fingerprintable WireGuard flow out of the box.
+export function createDefaultAmneziawgInboundSettings(
+  seed: AmneziawgInboundSeed = {},
+): AmneziawgInboundSettings {
+  return {
+    mtu: seed.mtu ?? 1420,
+    secretKey: seed.secretKey ?? Wireguard.generateKeypair().privateKey,
+    peers: [],
+    clients: [],
+    noKernelTun: seed.noKernelTun ?? false,
+    awg: randomizeAwgParams(),
+  };
+}
