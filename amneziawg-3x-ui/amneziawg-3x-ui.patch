diff --git a/internal/awg/config.go b/internal/awg/config.go
new file mode 100644
index 0000000..b76858c
--- /dev/null
+++ b/internal/awg/config.go
@@ -0,0 +1,301 @@
+package awg
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/netip"
+	"strconv"
+	"strings"
+
+	"github.com/mhsanaei/3x-ui/v3/internal/database/model"
+	wgutil "github.com/mhsanaei/3x-ui/v3/internal/util/wireguard"
+)
+
+const (
+	defaultMTU          = 1420
+	defaultServerAddr   = "10.0.0.1/24"
+	defaultClientDNS    = "1.1.1.1, 1.0.0.1"
+	defaultAllowedIPs   = "0.0.0.0/0, ::/0"
+	defaultKeepAliveSec = 25
+)
+
+// Peer is one accepted AmneziaWG client device, projected from a managed
+// inbound client. Email is carried only for traffic attribution.
+type Peer struct {
+	Email        string
+	PublicKey    string
+	PreSharedKey string
+	AllowedIPs   []string
+	KeepAlive    int
+}
+
+// Instance is the desired runtime state of one AmneziaWG inbound: everything
+// needed to stand up the in-process device and its peers.
+type Instance struct {
+	Id         int
+	Tag        string
+	ListenPort int
+	SecretKey  string
+	Mtu        int
+	Addresses  []netip.Prefix
+	Params     Params
+	Peers      []Peer
+}
+
+type awgInboundSettings struct {
+	SecretKey string          `json:"secretKey"`
+	MTU       int             `json:"mtu"`
+	DNS       string          `json:"dns"`
+	Address   json.RawMessage `json:"address"`
+	AWG       *Params         `json:"awg"`
+	Clients   []model.Client  `json:"clients"`
+}
+
+// InstanceFromInbound parses an AmneziaWG inbound's settings JSON into a desired
+// Instance. It returns false when the inbound is not AmneziaWG or has no server
+// secret key (nothing to run).
+func InstanceFromInbound(ib *model.Inbound) (Instance, bool) {
+	if ib == nil || ib.Protocol != model.AmneziaWG {
+		return Instance{}, false
+	}
+	var s awgInboundSettings
+	if err := json.Unmarshal([]byte(ib.Settings), &s); err != nil {
+		return Instance{}, false
+	}
+	if strings.TrimSpace(s.SecretKey) == "" {
+		return Instance{}, false
+	}
+	mtu := s.MTU
+	if mtu <= 0 {
+		mtu = defaultMTU
+	}
+	inst := Instance{
+		Id:         ib.Id,
+		Tag:        ib.Tag,
+		ListenPort: ib.Port,
+		SecretKey:  strings.TrimSpace(s.SecretKey),
+		Mtu:        mtu,
+		Addresses:  parseServerAddresses(s.Address, s.Clients),
+	}
+	if s.AWG != nil {
+		inst.Params = *s.AWG
+	}
+	for i := range s.Clients {
+		c := s.Clients[i]
+		if !c.Enable || strings.TrimSpace(c.PublicKey) == "" {
+			continue
+		}
+		inst.Peers = append(inst.Peers, Peer{
+			Email:        c.Email,
+			PublicKey:    c.PublicKey,
+			PreSharedKey: c.PreSharedKey,
+			AllowedIPs:   c.AllowedIPs,
+			KeepAlive:    c.KeepAlive,
+		})
+	}
+	return inst, true
+}
+
+// parseServerAddresses resolves the tunnel address(es) the device answers for.
+// It honours an explicit settings.address (string or array), otherwise derives
+// the .1 host of the clients' /24, otherwise falls back to 10.0.0.1/24.
+func parseServerAddresses(raw json.RawMessage, clients []model.Client) []netip.Prefix {
+	for _, s := range decodeStringOrArray(raw) {
+		if p, err := netip.ParsePrefix(strings.TrimSpace(s)); err == nil {
+			return []netip.Prefix{p}
+		}
+		if a, err := netip.ParseAddr(strings.TrimSpace(s)); err == nil {
+			return []netip.Prefix{netip.PrefixFrom(a, a.BitLen())}
+		}
+	}
+	for _, c := range clients {
+		for _, ip := range c.AllowedIPs {
+			if a := hostAddr(ip); a.IsValid() && a.Is4() {
+				if base, err := a.Prefix(24); err == nil {
+					return []netip.Prefix{netip.PrefixFrom(base.Addr().Next(), 24)}
+				}
+			}
+		}
+	}
+	p := netip.MustParsePrefix(defaultServerAddr)
+	return []netip.Prefix{p}
+}
+
+func decodeStringOrArray(raw json.RawMessage) []string {
+	if len(raw) == 0 {
+		return nil
+	}
+	var arr []string
+	if err := json.Unmarshal(raw, &arr); err == nil {
+		return arr
+	}
+	var one string
+	if err := json.Unmarshal(raw, &one); err == nil && one != "" {
+		return []string{one}
+	}
+	return nil
+}
+
+func hostAddr(s string) netip.Addr {
+	s = strings.TrimSpace(s)
+	if p, err := netip.ParsePrefix(s); err == nil {
+		return p.Addr()
+	}
+	if a, err := netip.ParseAddr(s); err == nil {
+		return a
+	}
+	return netip.Addr{}
+}
+
+// localAddrs returns the tunnel addresses as bare netip.Addr for the netstack.
+func (inst Instance) localAddrs() []netip.Addr {
+	out := make([]netip.Addr, 0, len(inst.Addresses))
+	for _, p := range inst.Addresses {
+		out = append(out, p.Addr())
+	}
+	return out
+}
+
+// uapiConfig renders the full amneziawg-go IpcSet payload: the server private
+// key, listen port, obfuscation params, and every peer. Keys are hex-encoded as
+// the WireGuard UAPI requires.
+func (inst Instance) uapiConfig() (string, error) {
+	privHex, err := wgutil.KeyToHex(inst.SecretKey)
+	if err != nil {
+		return "", fmt.Errorf("awg: bad server secret key: %w", err)
+	}
+	var sb strings.Builder
+	sb.WriteString("private_key=" + privHex + "\n")
+	fmt.Fprintf(&sb, "listen_port=%d\n", inst.ListenPort)
+	inst.Params.appendUAPILines(&sb)
+	if err := inst.appendPeers(&sb); err != nil {
+		return "", err
+	}
+	return sb.String(), nil
+}
+
+// peersUAPIConfig renders only the peer set, prefixed with replace_peers so a
+// live IpcSet replaces the device's peers without a restart (used when clients
+// change but the device parameters do not).
+func (inst Instance) peersUAPIConfig() (string, error) {
+	var sb strings.Builder
+	if err := inst.appendPeers(&sb); err != nil {
+		return "", err
+	}
+	return sb.String(), nil
+}
+
+func (inst Instance) appendPeers(sb *strings.Builder) error {
+	sb.WriteString("replace_peers=true\n")
+	for _, peer := range inst.Peers {
+		pubHex, err := wgutil.KeyToHex(peer.PublicKey)
+		if err != nil {
+			return fmt.Errorf("awg: bad peer public key for %s: %w", peer.Email, err)
+		}
+		sb.WriteString("public_key=" + pubHex + "\n")
+		if peer.PreSharedKey != "" {
+			pskHex, err := wgutil.KeyToHex(peer.PreSharedKey)
+			if err != nil {
+				return fmt.Errorf("awg: bad preshared key for %s: %w", peer.Email, err)
+			}
+			sb.WriteString("preshared_key=" + pskHex + "\n")
+		}
+		sb.WriteString("replace_allowed_ips=true\n")
+		for _, ip := range peer.AllowedIPs {
+			ip = strings.TrimSpace(ip)
+			if ip == "" {
+				continue
+			}
+			if !strings.Contains(ip, "/") {
+				if a := hostAddr(ip); a.IsValid() {
+					ip = netip.PrefixFrom(a, a.BitLen()).String()
+				}
+			}
+			sb.WriteString("allowed_ip=" + ip + "\n")
+		}
+		if peer.KeepAlive > 0 {
+			fmt.Fprintf(sb, "persistent_keepalive_interval=%d\n", peer.KeepAlive)
+		}
+	}
+	return nil
+}
+
+// deviceFingerprint captures the values that require a full device restart when
+// they change (listen port, server key, MTU, obfuscation params, addresses).
+func (inst Instance) deviceFingerprint() string {
+	parts := []string{
+		strconv.Itoa(inst.ListenPort), inst.SecretKey, strconv.Itoa(inst.Mtu),
+		inst.Params.fingerprint(),
+	}
+	for _, p := range inst.Addresses {
+		parts = append(parts, p.String())
+	}
+	return strings.Join(parts, "|")
+}
+
+// peersFingerprint captures the peer set so a client add/remove/edit can be
+// applied live without restarting the device.
+func (inst Instance) peersFingerprint() string {
+	parts := make([]string, 0, len(inst.Peers))
+	for _, peer := range inst.Peers {
+		parts = append(parts, peer.PublicKey+","+peer.PreSharedKey+","+strings.Join(peer.AllowedIPs, ",")+","+strconv.Itoa(peer.KeepAlive))
+	}
+	return strings.Join(parts, "|")
+}
+
+// ClientConfigOptions carries everything needed to render one client .conf.
+type ClientConfigOptions struct {
+	PrivateKey      string
+	Address         string
+	DNS             string
+	MTU             int
+	Params          Params
+	ServerPublicKey string
+	PreSharedKey    string
+	Endpoint        string
+	AllowedIPs      string
+	KeepAlive       int
+	Remark          string
+}
+
+// BuildClientConfig renders an AmneziaWG client .conf. It is a standard
+// wg-quick file plus the obfuscation keys, importable by the AmneziaWG apps.
+func BuildClientConfig(opts ClientConfigOptions) string {
+	address := opts.Address
+	if strings.TrimSpace(address) == "" {
+		address = "10.0.0.2/32"
+	}
+	dns := opts.DNS
+	if strings.TrimSpace(dns) == "" {
+		dns = defaultClientDNS
+	}
+	allowed := opts.AllowedIPs
+	if strings.TrimSpace(allowed) == "" {
+		allowed = defaultAllowedIPs
+	}
+	var sb strings.Builder
+	if r := strings.TrimSpace(opts.Remark); r != "" {
+		sb.WriteString("# " + r + "\n")
+	}
+	sb.WriteString("[Interface]\n")
+	sb.WriteString("PrivateKey = " + opts.PrivateKey + "\n")
+	sb.WriteString("Address = " + address + "\n")
+	sb.WriteString("DNS = " + dns + "\n")
+	if opts.MTU > 0 {
+		fmt.Fprintf(&sb, "MTU = %d\n", opts.MTU)
+	}
+	opts.Params.appendConfLines(&sb)
+	sb.WriteString("\n[Peer]\n")
+	sb.WriteString("PublicKey = " + opts.ServerPublicKey + "\n")
+	if strings.TrimSpace(opts.PreSharedKey) != "" {
+		sb.WriteString("PresharedKey = " + opts.PreSharedKey + "\n")
+	}
+	sb.WriteString("AllowedIPs = " + allowed + "\n")
+	sb.WriteString("Endpoint = " + opts.Endpoint + "\n")
+	keepAlive := opts.KeepAlive
+	if keepAlive <= 0 {
+		keepAlive = defaultKeepAliveSec
+	}
+	fmt.Fprintf(&sb, "PersistentKeepalive = %d\n", keepAlive)
+	return sb.String()
+}
