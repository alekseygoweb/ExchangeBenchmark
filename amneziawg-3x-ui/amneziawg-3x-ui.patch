new file mode 100644
index 0000000..ee69828
--- /dev/null
+++ b/internal/awg/forwarder.go
@@ -0,0 +1,289 @@
+package awg
+
+import (
+	"context"
+	"io"
+	"net"
+	"net/netip"
+	"sync"
+	"time"
+
+	"gvisor.dev/gvisor/pkg/buffer"
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/adapters/gonet"
+	"gvisor.dev/gvisor/pkg/tcpip/checksum"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+	"gvisor.dev/gvisor/pkg/tcpip/transport/tcp"
+	"gvisor.dev/gvisor/pkg/tcpip/transport/udp"
+	"gvisor.dev/gvisor/pkg/waiter"
+
+	"github.com/mhsanaei/3x-ui/v3/internal/logger"
+	"github.com/mhsanaei/3x-ui/v3/internal/util/netsafe"
+)
+
+// Dialer opens connections to the real destination a tunnelled client asked
+// for. Production uses a plain net.Dialer so traffic egresses through the host;
+// tests inject a fake to observe forwarding without real network access.
+type Dialer interface {
+	DialContext(ctx context.Context, network, address string) (net.Conn, error)
+}
+
+const (
+	udpSessionTimeout = 60 * time.Second
+	udpBufferSize     = 65535
+	dialTimeout       = 12 * time.Second
+)
+
+// forwarder splices decrypted client flows to their destinations. It is
+// installed on the gVisor stack after the AmneziaWG device is up.
+type forwarder struct {
+	stack  *stack.Stack
+	dialer Dialer
+
+	mu       sync.Mutex
+	sessions map[string]*udpSession
+	closed   bool
+}
+
+func newForwarder(gstack *stack.Stack, dialer Dialer) *forwarder {
+	if dialer == nil {
+		dialer = &net.Dialer{Timeout: dialTimeout}
+	}
+	return &forwarder{
+		stack:    gstack,
+		dialer:   dialer,
+		sessions: make(map[string]*udpSession),
+	}
+}
+
+// install enables promiscuous+spoofing on the NIC (so the stack accepts and
+// answers for destinations that are not its own address) and wires the TCP and
+// UDP transport handlers that hand flows to the forwarder.
+func (f *forwarder) install() {
+	f.stack.SetPromiscuousMode(nicID, true)
+	f.stack.SetSpoofing(nicID, true)
+
+	tcpForwarder := tcp.NewForwarder(f.stack, 0, 65535, func(r *tcp.ForwarderRequest) {
+		id := r.ID()
+		var wq waiter.Queue
+		ep, tcpErr := r.CreateEndpoint(&wq)
+		if tcpErr != nil {
+			r.Complete(true)
+			return
+		}
+		r.Complete(false)
+		ep.SocketOptions().SetKeepAlive(true)
+		local := gonet.NewTCPConn(&wq, ep)
+		go f.handleTCP(local, addrPortOf(id.LocalAddress, id.LocalPort))
+	})
+	f.stack.SetTransportProtocolHandler(tcp.ProtocolNumber, tcpForwarder.HandlePacket)
+
+	f.stack.SetTransportProtocolHandler(udp.ProtocolNumber, func(id stack.TransportEndpointID, pkt *stack.PacketBuffer) bool {
+		payload := pkt.Data().AsRange().ToSlice()
+		src := addrPortOf(id.RemoteAddress, id.RemotePort)
+		dst := addrPortOf(id.LocalAddress, id.LocalPort)
+		if !src.IsValid() || !dst.IsValid() {
+			return true
+		}
+		f.handleUDP(src, dst, payload)
+		return true
+	})
+}
+
+func (f *forwarder) handleTCP(local net.Conn, dst netip.AddrPort) {
+	defer local.Close()
+	if blockedDestination(dst) {
+		logger.Debug("awg: blocked tcp to internal address ", dst.String())
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), dialTimeout)
+	remote, err := f.dialer.DialContext(ctx, "tcp", dst.String())
+	cancel()
+	if err != nil {
+		logger.Debug("awg: tcp dial ", dst.String(), " failed: ", err)
+		return
+	}
+	defer remote.Close()
+	relay(local, remote)
+}
+
+// relay copies bytes in both directions until either side closes, then unblocks
+// the peer so both goroutines exit.
+func relay(a, b net.Conn) {
+	done := make(chan struct{}, 2)
+	go func() {
+		_, _ = io.Copy(a, b)
+		done <- struct{}{}
+	}()
+	go func() {
+		_, _ = io.Copy(b, a)
+		done <- struct{}{}
+	}()
+	<-done
+	_ = a.SetDeadline(time.Now())
+	_ = b.SetDeadline(time.Now())
+	<-done
+}
+
+// udpSession is one userspace-NAT flow: a host UDP socket to a single
+// destination whose replies are written back into the tunnel as if they came
+// from that destination.
+type udpSession struct {
+	conn     net.Conn
+	src      netip.AddrPort
+	dst      netip.AddrPort
+	lastSeen time.Time
+}
+
+func (f *forwarder) handleUDP(src, dst netip.AddrPort, payload []byte) {
+	if blockedDestination(dst) {
+		return
+	}
+	key := src.String() + "|" + dst.String()
+
+	f.mu.Lock()
+	if f.closed {
+		f.mu.Unlock()
+		return
+	}
+	sess, ok := f.sessions[key]
+	if !ok {
+		ctx, cancel := context.WithTimeout(context.Background(), dialTimeout)
+		conn, err := f.dialer.DialContext(ctx, "udp", dst.String())
+		cancel()
+		if err != nil {
+			f.mu.Unlock()
+			logger.Debug("awg: udp dial ", dst.String(), " failed: ", err)
+			return
+		}
+		sess = &udpSession{conn: conn, src: src, dst: dst, lastSeen: time.Now()}
+		f.sessions[key] = sess
+		go f.udpReadLoop(key, sess)
+	}
+	sess.lastSeen = time.Now()
+	conn := sess.conn
+	f.mu.Unlock()
+
+	_, _ = conn.Write(payload)
+}
+
+func (f *forwarder) udpReadLoop(key string, sess *udpSession) {
+	buf := make([]byte, udpBufferSize)
+	defer f.closeUDP(key, sess)
+	for {
+		_ = sess.conn.SetReadDeadline(time.Now().Add(udpSessionTimeout))
+		n, err := sess.conn.Read(buf)
+		if n > 0 {
+			if writeErr := f.writeRawUDP(sess.dst, sess.src, buf[:n]); writeErr != nil {
+				logger.Debug("awg: udp write-back failed: ", writeErr)
+				return
+			}
+			f.mu.Lock()
+			sess.lastSeen = time.Now()
+			f.mu.Unlock()
+		}
+		if err != nil {
+			return
+		}
+	}
+}
+
+func (f *forwarder) closeUDP(key string, sess *udpSession) {
+	f.mu.Lock()
+	if cur, ok := f.sessions[key]; ok && cur == sess {
+		delete(f.sessions, key)
+	}
+	f.mu.Unlock()
+	_ = sess.conn.Close()
+}
+
+func (f *forwarder) close() {
+	f.mu.Lock()
+	f.closed = true
+	sessions := f.sessions
+	f.sessions = make(map[string]*udpSession)
+	f.mu.Unlock()
+	for _, sess := range sessions {
+		_ = sess.conn.Close()
+	}
+}
+
+// writeRawUDP crafts a UDP/IP packet (src=the real destination, dst=the client)
+// and injects it into the stack so the AmneziaWG device encrypts it back to the
+// client. Mirrors xray-core's WireGuard reply path.
+func (f *forwarder) writeRawUDP(src, dst netip.AddrPort, payload []byte) error {
+	udpLen := header.UDPMinimumSize + len(payload)
+	srcIP := tcpip.AddrFromSlice(src.Addr().AsSlice())
+	dstIP := tcpip.AddrFromSlice(dst.Addr().AsSlice())
+
+	isIPv4 := dst.Addr().Is4()
+	ipHdrSize := header.IPv6MinimumSize
+	ipProtocol := header.IPv6ProtocolNumber
+	if isIPv4 {
+		ipHdrSize = header.IPv4MinimumSize
+		ipProtocol = header.IPv4ProtocolNumber
+	}
+
+	pkt := stack.NewPacketBuffer(stack.PacketBufferOptions{
+		ReserveHeaderBytes: ipHdrSize + header.UDPMinimumSize,
+		Payload:            buffer.MakeWithData(payload),
+	})
+	defer pkt.DecRef()
+
+	udpHdr := header.UDP(pkt.TransportHeader().Push(header.UDPMinimumSize))
+	udpHdr.Encode(&header.UDPFields{
+		SrcPort: src.Port(),
+		DstPort: dst.Port(),
+		Length:  uint16(udpLen),
+	})
+	xsum := header.PseudoHeaderChecksum(header.UDPProtocolNumber, srcIP, dstIP, uint16(udpLen))
+	udpHdr.SetChecksum(^udpHdr.CalculateChecksum(checksum.Checksum(payload, xsum)))
+
+	if isIPv4 {
+		ipHdr := header.IPv4(pkt.NetworkHeader().Push(header.IPv4MinimumSize))
+		ipHdr.Encode(&header.IPv4Fields{
+			TotalLength: uint16(header.IPv4MinimumSize + udpLen),
+			TTL:         64,
+			Protocol:    uint8(header.UDPProtocolNumber),
+			SrcAddr:     srcIP,
+			DstAddr:     dstIP,
+		})
+		ipHdr.SetChecksum(^ipHdr.CalculateChecksum())
+	} else {
+		ipHdr := header.IPv6(pkt.NetworkHeader().Push(header.IPv6MinimumSize))
+		ipHdr.Encode(&header.IPv6Fields{
+			PayloadLength:     uint16(udpLen),
+			TransportProtocol: header.UDPProtocolNumber,
+			HopLimit:          64,
+			SrcAddr:           srcIP,
+			DstAddr:           dstIP,
+		})
+	}
+
+	if tcpErr := f.stack.WriteRawPacket(nicID, ipProtocol, buffer.MakeWithView(pkt.ToView())); tcpErr != nil {
+		return &tcpipError{tcpErr}
+	}
+	return nil
+}
+
+// blockedDestination fences client egress: loopback, private, link-local and
+// unspecified targets are refused so a tunnelled client cannot reach the panel
+// host's own services (panel API, Xray gRPC, the devices themselves) or the
+// server's LAN. This is the userspace-forwarder equivalent of the host firewall
+// rules that would fence a kernel WireGuard interface.
+func blockedDestination(dst netip.AddrPort) bool {
+	return netsafe.IsBlockedIP(net.IP(dst.Addr().AsSlice()))
+}
+
+func addrPortOf(addr tcpip.Address, port uint16) netip.AddrPort {
+	ip, ok := netip.AddrFromSlice(addr.AsSlice())
+	if !ok {
+		return netip.AddrPort{}
+	}
+	return netip.AddrPortFrom(ip.Unmap(), port)
+}
+
+type tcpipError struct{ err tcpip.Error }
+
+func (e *tcpipError) Error() string { return e.err.String() }
diff --git a/internal/awg/forwarder_test.go b/internal/awg/forwarder_test.go
