diff --git a/internal/web/job/awg_job.go b/internal/web/job/awg_job.go
new file mode 100644
index 0000000..7c0ba79
--- /dev/null
+++ b/internal/web/job/awg_job.go
@@ -0,0 +1,74 @@
+package job
+
+import (
+	"github.com/mhsanaei/3x-ui/v3/internal/awg"
+	"github.com/mhsanaei/3x-ui/v3/internal/database/model"
+	"github.com/mhsanaei/3x-ui/v3/internal/logger"
+	"github.com/mhsanaei/3x-ui/v3/internal/web/service"
+	"github.com/mhsanaei/3x-ui/v3/internal/xray"
+)
+
+// AwgJob reconciles the in-process AmneziaWG devices against the enabled
+// amneziawg inbounds in the database and folds the per-peer traffic each device
+// reports into the usual inbound and client traffic accounting. AmneziaWG runs
+// inside the panel (no Xray inbound, no sidecar binary), so its clients would be
+// invisible to traffic limits and usage without this job.
+type AwgJob struct {
+	inboundService service.InboundService
+}
+
+// NewAwgJob creates a new AmneziaWG reconcile/traffic job instance.
+func NewAwgJob() *AwgJob {
+	return new(AwgJob)
+}
+
+// Run reconciles desired amneziawg inbounds with running devices and records
+// traffic deltas for both the inbound and its clients.
+func (j *AwgJob) Run() {
+	inbounds, err := j.inboundService.GetAllInbounds()
+	if err != nil {
+		logger.Warning("awg job: get inbounds failed:", err)
+		return
+	}
+
+	var desired []awg.Instance
+	for _, ib := range inbounds {
+		if ib.Protocol != model.AmneziaWG || !ib.Enable || ib.NodeID != nil {
+			continue
+		}
+		if inst, ok := awg.InstanceFromInbound(ib); ok {
+			desired = append(desired, inst)
+		}
+	}
+
+	mgr := awg.GetManager()
+	mgr.Reconcile(desired)
+
+	deltas := mgr.CollectTraffic()
+	if len(deltas) == 0 {
+		return
+	}
+	inboundByTag := make(map[string]*xray.Traffic)
+	clientTraffics := make([]*xray.ClientTraffic, 0, len(deltas))
+	for _, d := range deltas {
+		agg, ok := inboundByTag[d.Tag]
+		if !ok {
+			agg = &xray.Traffic{IsInbound: true, Tag: d.Tag}
+			inboundByTag[d.Tag] = agg
+		}
+		agg.Up += d.Up
+		agg.Down += d.Down
+		clientTraffics = append(clientTraffics, &xray.ClientTraffic{
+			Email: d.Email,
+			Up:    d.Up,
+			Down:  d.Down,
+		})
+	}
+	traffics := make([]*xray.Traffic, 0, len(inboundByTag))
+	for _, t := range inboundByTag {
+		traffics = append(traffics, t)
+	}
+	if _, _, err := j.inboundService.AddTraffic(traffics, clientTraffics); err != nil {
+		logger.Warning("awg job: add traffic failed:", err)
+	}
+}
