+import { useTranslation } from 'react-i18next';
+import { Button, Collapse, Form, Input, InputNumber, Select, Space, Switch } from 'antd';
+import { ReloadOutlined, ThunderboltOutlined } from '@ant-design/icons';
+
+import { randomizeAwgParams } from '@/lib/xray/awg';
+
+interface AmneziawgFieldsProps {
+  wgPubKey: string;
+  regenInboundWg: () => void;
+}
+
+// Path helper for the inbound-level obfuscation object (settings.awg.*).
+const awgPath = (key: string): (string | number)[] => ['settings', 'awg', key];
+
+// AmneziaWG is WireGuard plus packet obfuscation: the top half mirrors
+// WireguardFields exactly (same server identity + per-client model), and the
+// bottom half edits the inbound-level `awg` obfuscation knobs that must match
+// between server and client for the handshake to complete.
+export default function AmneziawgFields({ wgPubKey, regenInboundWg }: AmneziawgFieldsProps) {
+  const { t } = useTranslation();
+  const form = Form.useFormInstance();
+
+  const randomizeAwg = () => {
+    form.setFieldValue(['settings', 'awg'], randomizeAwgParams());
+  };
+
+  return (
+    <>
+      <Form.Item label={t('pages.xray.wireguard.secretKey')}>
+        <Space.Compact block>
+          <Form.Item name={['settings', 'secretKey']} noStyle>
+            <Input style={{ width: 'calc(100% - 32px)' }} />
+          </Form.Item>
+          <Button aria-label={t('regenerate')} icon={<ReloadOutlined />} onClick={regenInboundWg} />
+        </Space.Compact>
+      </Form.Item>
+      <Form.Item label={t('pages.xray.wireguard.publicKey')}>
+        <Input value={wgPubKey} disabled />
+      </Form.Item>
+      <Form.Item name={['settings', 'mtu']} label="MTU">
+        <InputNumber />
+      </Form.Item>
+      <Form.Item name={['settings', 'dns']} label={t('pages.inbounds.info.dns')}>
+        <Input placeholder="1.1.1.1, 1.0.0.1" />
+      </Form.Item>
+      <Form.Item
+        name={['settings', 'noKernelTun']}
+        label={t('pages.inbounds.info.noKernelTun')}
+        valuePropName="checked"
+      >
+        <Switch />
+      </Form.Item>
+      <Form.Item name={['settings', 'domainStrategy']} label={t('pages.xray.wireguard.domainStrategy')}>
+        <Select
+          allowClear
+          options={[
+            { value: 'ForceIP', label: 'ForceIP' },
+            { value: 'ForceIPv4', label: 'ForceIPv4' },
+            { value: 'ForceIPv4v6', label: 'ForceIPv4v6' },
+            { value: 'ForceIPv6', label: 'ForceIPv6' },
+            { value: 'ForceIPv6v4', label: 'ForceIPv6v4' },
+          ]}
+        />
+      </Form.Item>
+
+      <Form.Item label={t('pages.xray.amneziawg.title')} extra={t('pages.xray.amneziawg.note')}>
+        <Button icon={<ThunderboltOutlined />} onClick={randomizeAwg}>
+          {t('pages.xray.amneziawg.randomize')}
+        </Button>
+      </Form.Item>
+
+      <Form.Item name={awgPath('jc')} label={t('pages.xray.amneziawg.jc')}>
+        <InputNumber min={0} style={{ width: '100%' }} />
+      </Form.Item>
+      <Form.Item name={awgPath('jmin')} label={t('pages.xray.amneziawg.jmin')}>
+        <InputNumber min={0} style={{ width: '100%' }} />
+      </Form.Item>
+      <Form.Item name={awgPath('jmax')} label={t('pages.xray.amneziawg.jmax')}>
+        <InputNumber min={0} style={{ width: '100%' }} />
+      </Form.Item>
+      <Form.Item name={awgPath('s1')} label={t('pages.xray.amneziawg.s1')}>
+        <InputNumber min={0} style={{ width: '100%' }} />
+      </Form.Item>
+      <Form.Item name={awgPath('s2')} label={t('pages.xray.amneziawg.s2')}>
+        <InputNumber min={0} style={{ width: '100%' }} />
+      </Form.Item>
+
+      <Collapse
+        ghost
+        items={[
+          {
+            key: 'advanced',
+            label: t('pages.xray.amneziawg.advanced'),
+            children: (
+              <>
+                <Form.Item name={awgPath('s3')} label={t('pages.xray.amneziawg.s3')}>
+                  <InputNumber min={0} style={{ width: '100%' }} />
+                </Form.Item>
+                <Form.Item name={awgPath('s4')} label={t('pages.xray.amneziawg.s4')}>
+                  <InputNumber min={0} style={{ width: '100%' }} />
+                </Form.Item>
+                <Form.Item name={awgPath('h1')} label={t('pages.xray.amneziawg.h1')}>
+                  <Input />
+                </Form.Item>
+                <Form.Item name={awgPath('h2')} label={t('pages.xray.amneziawg.h2')}>
+                  <Input />
+                </Form.Item>
+                <Form.Item name={awgPath('h3')} label={t('pages.xray.amneziawg.h3')}>
+                  <Input />
+                </Form.Item>
+                <Form.Item name={awgPath('h4')} label={t('pages.xray.amneziawg.h4')}>
+                  <Input />
+                </Form.Item>
+                <Form.Item name={awgPath('i1')} label={t('pages.xray.amneziawg.i1')}>
+                  <Input />
+                </Form.Item>
+                <Form.Item name={awgPath('i2')} label={t('pages.xray.amneziawg.i2')}>
+                  <Input />
+                </Form.Item>
+                <Form.Item name={awgPath('i3')} label={t('pages.xray.amneziawg.i3')}>
+                  <Input />
+                </Form.Item>
+                <Form.Item name={awgPath('i4')} label={t('pages.xray.amneziawg.i4')}>
+                  <Input />
+                </Form.Item>
+                <Form.Item name={awgPath('i5')} label={t('pages.xray.amneziawg.i5')}>
+                  <Input />
+                </Form.Item>
+              </>
+            ),
+          },
+        ]}
+      />
+    </>
+  );
+}
