@@ -0,0 +1,197 @@
+package awg
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/mhsanaei/3x-ui/v3/internal/database/model"
+	wgutil "github.com/mhsanaei/3x-ui/v3/internal/util/wireguard"
+)
+
+func mustKeypair(t *testing.T) (priv, pub string) {
+	t.Helper()
+	priv, pub, err := wgutil.GenerateWireguardKeypair()
+	if err != nil {
+		t.Fatalf("keypair: %v", err)
+	}
+	return priv, pub
+}
+
+func buildInbound(t *testing.T, secret string, clients []map[string]any, awgParams map[string]any) *model.Inbound {
+	t.Helper()
+	settings := map[string]any{
+		"secretKey": secret,
+		"mtu":       1420,
+		"dns":       "1.1.1.1",
+		"clients":   clients,
+	}
+	if awgParams != nil {
+		settings["awg"] = awgParams
+	}
+	raw, err := json.Marshal(settings)
+	if err != nil {
+		t.Fatalf("marshal: %v", err)
+	}
+	return &model.Inbound{
+		Id:       7,
+		Tag:      "inbound-7",
+		Port:     51820,
+		Protocol: model.AmneziaWG,
+		Settings: string(raw),
+	}
+}
+
+func TestInstanceFromInboundFiltersPeers(t *testing.T) {
+	serverPriv, _ := mustKeypair(t)
+	_, pub1 := mustKeypair(t)
+	_, pub2 := mustKeypair(t)
+
+	clients := []map[string]any{
+		{"email": "alice", "enable": true, "publicKey": pub1, "allowedIPs": []string{"10.0.0.2/32"}, "keepAlive": 25},
+		{"email": "bob-disabled", "enable": false, "publicKey": pub2, "allowedIPs": []string{"10.0.0.3/32"}},
+		{"email": "carol-nokey", "enable": true, "publicKey": "", "allowedIPs": []string{"10.0.0.4/32"}},
+	}
+	awgParams := map[string]any{"jc": 4, "jmin": 40, "jmax": 70, "s1": 30, "s2": 40, "h1": "10", "h2": "20", "h3": "30", "h4": "40"}
+	ib := buildInbound(t, serverPriv, clients, awgParams)
+
+	inst, ok := InstanceFromInbound(ib)
+	if !ok {
+		t.Fatal("InstanceFromInbound returned not ok")
+	}
+	if len(inst.Peers) != 1 {
+		t.Fatalf("expected 1 enabled peer with key, got %d", len(inst.Peers))
+	}
+	if inst.Peers[0].Email != "alice" {
+		t.Fatalf("expected alice, got %q", inst.Peers[0].Email)
+	}
+	if inst.ListenPort != 51820 || inst.Mtu != 1420 {
+		t.Fatalf("unexpected listen/mtu: %d/%d", inst.ListenPort, inst.Mtu)
+	}
+	if inst.Params.Jc != 4 || inst.Params.H1 != "10" {
+		t.Fatalf("params not parsed: %+v", inst.Params)
+	}
+	if len(inst.Addresses) == 0 || !strings.HasPrefix(inst.Addresses[0].String(), "10.0.0.1") {
+		t.Fatalf("server address should derive to 10.0.0.1, got %v", inst.Addresses)
+	}
+}
+
+func TestInstanceFromInboundRejectsWrongProtocolAndNoKey(t *testing.T) {
+	if _, ok := InstanceFromInbound(&model.Inbound{Protocol: model.WireGuard}); ok {
+		t.Fatal("wireguard inbound should not parse as amneziawg")
+	}
+	ib := &model.Inbound{Protocol: model.AmneziaWG, Settings: `{"mtu":1420}`}
+	if _, ok := InstanceFromInbound(ib); ok {
+		t.Fatal("amneziawg inbound without secretKey should not parse")
+	}
+}
+
+func TestUAPIConfigHexAndPeers(t *testing.T) {
+	serverPriv, _ := mustKeypair(t)
+	_, pub1 := mustKeypair(t)
+	clients := []map[string]any{
+		{"email": "alice", "enable": true, "publicKey": pub1, "allowedIPs": []string{"10.0.0.2/32"}, "keepAlive": 25},
+	}
+	ib := buildInbound(t, serverPriv, clients, map[string]any{"jc": 3, "jmin": 40, "jmax": 70})
+	inst, ok := InstanceFromInbound(ib)
+	if !ok {
+		t.Fatal("not ok")
+	}
+	uapi, err := inst.uapiConfig()
+	if err != nil {
+		t.Fatalf("uapiConfig: %v", err)
+	}
+	privHex, _ := wgutil.KeyToHex(serverPriv)
+	pubHex, _ := wgutil.KeyToHex(pub1)
+	for _, want := range []string{
+		"private_key=" + privHex + "\n",
+		"listen_port=51820\n",
+		"jc=3\n",
+		"replace_peers=true\n",
+		"public_key=" + pubHex + "\n",
+		"allowed_ip=10.0.0.2/32\n",
+		"persistent_keepalive_interval=25\n",
+	} {
+		if !strings.Contains(uapi, want) {
+			t.Fatalf("uapi missing %q in:\n%s", want, uapi)
+		}
+	}
+	if strings.Contains(uapi, serverPriv) {
+		t.Fatal("uapi must use hex keys, not the base64 form")
+	}
+}
+
+func TestBuildClientConfig(t *testing.T) {
+	conf := BuildClientConfig(ClientConfigOptions{
+		PrivateKey:      "CLIENTPRIV",
+		Address:         "10.0.0.2/32",
+		DNS:             "1.1.1.1",
+		MTU:             1420,
+		Params:          Params{Jc: 4, Jmin: 40, Jmax: 70, S1: 30, S2: 40, H1: "10", H2: "20", H3: "30", H4: "40"},
+		ServerPublicKey: "SERVERPUB",
+		PreSharedKey:    "PSK",
+		Endpoint:        "vpn.example.com:51820",
+		Remark:          "inbound-7 - alice",
+	})
+	for _, want := range []string{
+		"[Interface]",
+		"PrivateKey = CLIENTPRIV",
+		"Address = 10.0.0.2/32",
+		"DNS = 1.1.1.1",
+		"MTU = 1420",
+		"Jc = 4",
+		"H1 = 10",
+		"[Peer]",
+		"PublicKey = SERVERPUB",
+		"PresharedKey = PSK",
+		"AllowedIPs = 0.0.0.0/0, ::/0",
+		"Endpoint = vpn.example.com:51820",
+		"PersistentKeepalive = 25",
+		"# inbound-7 - alice",
+	} {
+		if !strings.Contains(conf, want) {
+			t.Fatalf("client conf missing %q in:\n%s", want, conf)
+		}
+	}
+}
+
+func TestFingerprintsSplitDeviceAndPeers(t *testing.T) {
+	serverPriv, _ := mustKeypair(t)
+	_, pub1 := mustKeypair(t)
+	_, pub2 := mustKeypair(t)
+	base := []map[string]any{
+		{"email": "alice", "enable": true, "publicKey": pub1, "allowedIPs": []string{"10.0.0.2/32"}},
+	}
+	inst1, _ := InstanceFromInbound(buildInbound(t, serverPriv, base, nil))
+
+	withPeer := append([]map[string]any{}, base...)
+	withPeer = append(withPeer, map[string]any{"email": "bob", "enable": true, "publicKey": pub2, "allowedIPs": []string{"10.0.0.3/32"}})
+	inst2, _ := InstanceFromInbound(buildInbound(t, serverPriv, withPeer, nil))
+
+	if inst1.deviceFingerprint() != inst2.deviceFingerprint() {
+		t.Fatal("adding a peer must not change the device fingerprint")
+	}
+	if inst1.peersFingerprint() == inst2.peersFingerprint() {
+		t.Fatal("adding a peer must change the peers fingerprint")
+	}
+
+	inst3, _ := InstanceFromInbound(buildInbound(t, serverPriv, base, map[string]any{"jc": 5, "jmin": 40, "jmax": 70}))
+	if inst1.deviceFingerprint() == inst3.deviceFingerprint() {
+		t.Fatal("changing obfuscation params must change the device fingerprint")
+	}
+}
+
+func ExampleBuildClientConfig() {
+	conf := BuildClientConfig(ClientConfigOptions{
+		PrivateKey:      "priv",
+		Address:         "10.0.0.2/32",
+		DNS:             "1.1.1.1",
+		Params:          Params{Jc: 4, Jmin: 40, Jmax: 70, H1: "10", H2: "20", H3: "30", H4: "40"},
+		ServerPublicKey: "pub",
+		Endpoint:        "1.2.3.4:51820",
+		KeepAlive:       25,
+	})
+	fmt.Println(strings.Contains(conf, "Jc = 4"))
+	// Output: true
+}
diff --git a/internal/awg/device.go b/internal/awg/device.go
new file mode 100644
index 0000000..8cfed73
--- /dev/null
+++ b/internal/awg/device.go
@@ -0,0 +1,159 @@
+package awg
+
+import (
+	"bufio"
+	"fmt"
+	"strconv"
+	"strings"
+
+	"github.com/amnezia-vpn/amneziawg-go/conn"
+	"github.com/amnezia-vpn/amneziawg-go/device"
+
+	"github.com/mhsanaei/3x-ui/v3/internal/logger"
+	wgutil "github.com/mhsanaei/3x-ui/v3/internal/util/wireguard"
+)
+
+// PeerStat is a per-client traffic and liveness snapshot read from the running
+// device. Up is bytes received from the client, Down is bytes sent to it.
+type PeerStat struct {
+	Email         string
+	Up            int64
+	Down          int64
+	LastHandshake int64
+}
+
+// awgDevice owns one running in-process AmneziaWG server: the gVisor netstack,
+// the amneziawg-go device bound to the inbound's UDP port, and the forwarder
+// that carries decrypted client traffic to the internet.
+type awgDevice struct {
+	dev       *device.Device
+	forwarder *forwarder
+	pubToMail map[string]string
+}
+
+// startDevice stands up the netstack, configures the amneziawg-go device with
+// the server key, obfuscation params and peers, brings it up, and installs the
+// TCP/UDP forwarder.
+func startDevice(inst Instance, dialer Dialer) (*awgDevice, error) {
+	if err := inst.Params.Validate(); err != nil {
+		return nil, err
+	}
+	uapi, err := inst.uapiConfig()
+	if err != nil {
+		return nil, err
+	}
+	tunDev, gstack, err := createNetTUN(inst.localAddrs(), inst.Mtu)
+	if err != nil {
+		return nil, err
+	}
+	logf := func(format string, args ...any) {
+		logger.Debug("awg[", inst.Tag, "]: ", fmt.Sprintf(format, args...))
+	}
+	dev := device.NewDevice(tunDev, conn.NewDefaultBind(), &device.Logger{Verbosef: func(string, ...any) {}, Errorf: logf})
+	if err := dev.IpcSet(uapi); err != nil {
+		dev.Close()
+		return nil, fmt.Errorf("awg: IpcSet: %w", err)
+	}
+	if err := dev.Up(); err != nil {
+		dev.Close()
+		return nil, fmt.Errorf("awg: device up: %w", err)
+	}
+	fwd := newForwarder(gstack, dialer)
+	fwd.install()
+
+	pubToMail := make(map[string]string, len(inst.Peers))
+	for _, peer := range inst.Peers {
+		if hexPub, err := wgutil.KeyToHex(peer.PublicKey); err == nil {
+			pubToMail[hexPub] = peer.Email
+		}
+	}
+	return &awgDevice{dev: dev, forwarder: fwd, pubToMail: pubToMail}, nil
+}
+
+// applyPeers replaces the device's peer set live via IpcSet, so adding or
+// removing a client does not drop the other clients' sessions.
+func (d *awgDevice) applyPeers(inst Instance) error {
+	if d == nil || d.dev == nil {
+		return fmt.Errorf("awg: device not running")
+	}
+	uapi, err := inst.peersUAPIConfig()
+	if err != nil {
+		return err
+	}
+	if err := d.dev.IpcSet(uapi); err != nil {
+		return fmt.Errorf("awg: live peer update: %w", err)
+	}
+	pubToMail := make(map[string]string, len(inst.Peers))
+	for _, peer := range inst.Peers {
+		if hexPub, err := wgutil.KeyToHex(peer.PublicKey); err == nil {
+			pubToMail[hexPub] = peer.Email
+		}
+	}
+	d.pubToMail = pubToMail
+	return nil
+}
+
+func (d *awgDevice) close() {
+	if d == nil {
+		return
+	}
+	if d.forwarder != nil {
+		d.forwarder.close()
+	}
+	if d.dev != nil {
+		d.dev.Close()
+	}
+}
+
+// stats parses the device's IpcGet output into per-client counters. Unknown
+// peers (present on the wire but not in our email map) are skipped.
+func (d *awgDevice) stats() []PeerStat {
+	if d == nil || d.dev == nil {
+		return nil
+	}
+	raw, err := d.dev.IpcGet()
+	if err != nil {
+		return nil
+	}
+	var out []PeerStat
+	var cur *PeerStat
+	flush := func() {
+		if cur != nil && cur.Email != "" {
+			out = append(out, *cur)
+		}
+		cur = nil
+	}
+	scanner := bufio.NewScanner(strings.NewReader(raw))
+	for scanner.Scan() {
+		line := scanner.Text()
+		key, val, ok := strings.Cut(line, "=")
+		if !ok {
+			continue
+		}
+		switch key {
+		case "public_key":
+			flush()
+			email := d.pubToMail[val]
+			cur = &PeerStat{Email: email}
+		case "rx_bytes":
+			if cur != nil {
+				cur.Up = parseInt64(val)
+			}
+		case "tx_bytes":
+			if cur != nil {
+				cur.Down = parseInt64(val)
+			}
+		case "last_handshake_time_sec":
+			if cur != nil {
+				cur.LastHandshake = parseInt64(val)
+			}
+		}
+	}
+	flush()
+	return out
+}
+
+func parseInt64(s string) int64 {
+	v, _ := strconv.ParseInt(strings.TrimSpace(s), 10, 64)
+	return v
+}
