diff --git a/frontend/src/schemas/protocols/inbound/amneziawg.ts b/frontend/src/schemas/protocols/inbound/amneziawg.ts
new file mode 100644
index 0000000..bbf7b46
--- /dev/null
+++ b/frontend/src/schemas/protocols/inbound/amneziawg.ts
@@ -0,0 +1,49 @@
+import { z } from 'zod';
+
+import { WireguardInboundSettingsSchema } from './wireguard';
+
+// AmneziaWG is WireGuard plus packet obfuscation: it reuses the exact same
+// server identity (secretKey/mtu/dns) and per-client model (keypair/allowedIPs/
+// preSharedKey/keepAlive) as WireGuard, and adds an inbound-level obfuscation
+// object (`awg`) whose knobs must match between server and client.
+
+// AntD InputNumber emits null (not undefined) when the user clears a field, and
+// the form store hands that null to safeParse on submit — coalesce it to the
+// 0 default so an unset knob round-trips instead of blocking the save.
+const clearedInt = (schema: z.ZodNumber) =>
+  z.preprocess((v) => (v == null ? 0 : v), schema.default(0));
+
+// The obfuscation parameters mirror the Go awg.Params struct: jc/jmin/jmax
+// (junk packets), s1-s4 (message paddings) are integers (0 = off); h1-h4
+// (magic headers, a uint32 or an "x-y" range) and i1-i5 (optional CPS junk
+// tags, usually left blank in the UI) are strings.
+export const AmneziawgParamsSchema = z.object({
+  jc: clearedInt(z.number().int().min(0)),
+  jmin: clearedInt(z.number().int().min(0)),
+  jmax: clearedInt(z.number().int().min(0)),
+  s1: clearedInt(z.number().int().min(0)),
+  s2: clearedInt(z.number().int().min(0)),
+  s3: clearedInt(z.number().int().min(0)),
+  s4: clearedInt(z.number().int().min(0)),
+  h1: z.string().default(''),
+  h2: z.string().default(''),
+  h3: z.string().default(''),
+  h4: z.string().default(''),
+  i1: z.string().default(''),
+  i2: z.string().default(''),
+  i3: z.string().default(''),
+  i4: z.string().default(''),
+  i5: z.string().default(''),
+});
+export type AmneziawgParams = z.infer<typeof AmneziawgParamsSchema>;
+
+// The inbound settings are the WireGuard settings (secretKey/mtu/dns/peers/
+// clients/noKernelTun/domainStrategy — reused verbatim so the two protocols
+// never drift) plus the optional `awg` obfuscation object and an optional
+// server `address` (a single string or a list, allocated server-side when
+// absent).
+export const AmneziawgInboundSettingsSchema = WireguardInboundSettingsSchema.extend({
+  address: z.union([z.string(), z.array(z.string())]).optional(),
+  awg: AmneziawgParamsSchema.optional(),
+});
+export type AmneziawgInboundSettings = z.infer<typeof AmneziawgInboundSettingsSchema>;
