@@ -0,0 +1,37 @@
+package awg
+
+import (
+	"net/netip"
+	"testing"
+)
+
+func TestBlockedDestination(t *testing.T) {
+	blocked := []string{
+		"127.0.0.1:80",
+		"10.0.0.5:443",
+		"192.168.1.1:53",
+		"172.16.0.1:443",
+		"169.254.1.1:80",
+		"0.0.0.0:80",
+		"[::1]:443",
+		"[fe80::1]:443",
+	}
+	for _, s := range blocked {
+		ap := netip.MustParseAddrPort(s)
+		if !blockedDestination(ap) {
+			t.Errorf("expected %s to be blocked (internal address)", s)
+		}
+	}
+	allowed := []string{
+		"1.1.1.1:53",
+		"8.8.8.8:443",
+		"93.184.216.34:80",
+		"[2606:4700:4700::1111]:443",
+	}
+	for _, s := range allowed {
+		ap := netip.MustParseAddrPort(s)
+		if blockedDestination(ap) {
+			t.Errorf("expected %s to be allowed (public address)", s)
+		}
+	}
+}
diff --git a/internal/awg/manager.go b/internal/awg/manager.go
new file mode 100644
index 0000000..afb61b2
--- /dev/null
+++ b/internal/awg/manager.go
@@ -0,0 +1,182 @@
+package awg
+
+import (
+	"sync"
+
+	"github.com/mhsanaei/3x-ui/v3/internal/logger"
+)
+
+// Traffic is a per-client traffic delta collected from a running device between
+// two polls, tagged with the owning inbound.
+type Traffic struct {
+	Tag   string
+	Email string
+	Up    int64
+	Down  int64
+}
+
+// managed is the actual running state of one AmneziaWG inbound.
+type managed struct {
+	dev         *awgDevice
+	tag         string
+	devicePrint string
+	peersPrint  string
+	lastUp      map[string]int64
+	lastDown    map[string]int64
+}
+
+// Manager supervises the in-process AmneziaWG devices, one per inbound id. It
+// is the AmneziaWG analogue of the mtproto sidecar manager: desired state comes
+// from the DB, actual state lives here, and a fingerprint decides when a device
+// must be rebuilt versus updated live.
+type Manager struct {
+	mu     sync.Mutex
+	devs   map[int]*managed
+	dialer Dialer
+}
+
+var (
+	manager     *Manager
+	managerOnce sync.Once
+)
+
+// GetManager returns the process-wide AmneziaWG manager singleton.
+func GetManager() *Manager {
+	managerOnce.Do(func() {
+		manager = &Manager{devs: make(map[int]*managed)}
+	})
+	return manager
+}
+
+// SetDialer overrides the egress dialer used by every device started
+// afterwards. Intended for tests; production uses the default host dialer.
+func (m *Manager) SetDialer(d Dialer) {
+	m.mu.Lock()
+	m.dialer = d
+	m.mu.Unlock()
+}
+
+// Ensure brings a single inbound's device to the desired state, starting,
+// restarting, or live-updating it as needed.
+func (m *Manager) Ensure(inst Instance) error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	return m.ensureLocked(inst)
+}
+
+func (m *Manager) ensureLocked(inst Instance) error {
+	devPrint := inst.deviceFingerprint()
+	peersPrint := inst.peersFingerprint()
+
+	if cur, ok := m.devs[inst.Id]; ok {
+		if cur.devicePrint == devPrint {
+			cur.tag = inst.Tag
+			if cur.peersPrint == peersPrint {
+				return nil
+			}
+			if err := cur.dev.applyPeers(inst); err != nil {
+				return err
+			}
+			cur.peersPrint = peersPrint
+			return nil
+		}
+		cur.dev.close()
+		delete(m.devs, inst.Id)
+	}
+
+	dev, err := startDevice(inst, m.dialer)
+	if err != nil {
+		return err
+	}
+	m.devs[inst.Id] = &managed{
+		dev:         dev,
+		tag:         inst.Tag,
+		devicePrint: devPrint,
+		peersPrint:  peersPrint,
+		lastUp:      make(map[string]int64),
+		lastDown:    make(map[string]int64),
+	}
+	logger.Info("awg: started inbound ", inst.Tag, " on port ", inst.ListenPort, " with ", len(inst.Peers), " peer(s)")
+	return nil
+}
+
+// Remove stops and forgets the device for an inbound id.
+func (m *Manager) Remove(id int) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if cur, ok := m.devs[id]; ok {
+		cur.dev.close()
+		delete(m.devs, id)
+		logger.Info("awg: stopped inbound ", cur.tag)
+	}
+}
+
+// Reconcile drives the running devices to exactly match the desired set: it
+// stops devices whose inbound is gone or disabled and ensures the rest.
+func (m *Manager) Reconcile(desired []Instance) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	want := make(map[int]struct{}, len(desired))
+	for _, inst := range desired {
+		want[inst.Id] = struct{}{}
+	}
+	for id, cur := range m.devs {
+		if _, ok := want[id]; !ok {
+			cur.dev.close()
+			delete(m.devs, id)
+			logger.Info("awg: stopped inbound ", cur.tag)
+		}
+	}
+	for _, inst := range desired {
+		if err := m.ensureLocked(inst); err != nil {
+			logger.Warning("awg: ensure inbound ", inst.Tag, " failed: ", err)
+		}
+	}
+}
+
+// StopAll tears down every running device (panel shutdown).
+func (m *Manager) StopAll() {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	for id, cur := range m.devs {
+		cur.dev.close()
+		delete(m.devs, id)
+	}
+}
+
+// CollectTraffic snapshots every device's per-peer counters and returns the
+// positive deltas since the previous call, so the reconcile job can fold them
+// into inbound and client traffic totals.
+func (m *Manager) CollectTraffic() []Traffic {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	var out []Traffic
+	for _, cur := range m.devs {
+		for _, st := range cur.dev.stats() {
+			if st.Email == "" {
+				continue
+			}
+			up := delta(cur.lastUp, st.Email, st.Up)
+			down := delta(cur.lastDown, st.Email, st.Down)
+			if up == 0 && down == 0 {
+				continue
+			}
+			out = append(out, Traffic{Tag: cur.tag, Email: st.Email, Up: up, Down: down})
+		}
+	}
+	return out
+}
+
+// delta returns the non-negative increase of a cumulative counter versus its
+// stored baseline, then updates the baseline. A drop (device restart resets the
+// counter to a lower value) yields 0 rather than a negative delta.
+func delta(baseline map[string]int64, email string, current int64) int64 {
+	prev, ok := baseline[email]
+	baseline[email] = current
+	if !ok || current < prev {
+		return 0
+	}
+	return current - prev
+}
diff --git a/internal/awg/manager_test.go b/internal/awg/manager_test.go
new file mode 100644
index 0000000..6b27dc2
--- /dev/null
+++ b/internal/awg/manager_test.go
@@ -0,0 +1,124 @@
+package awg
+
+import (
+	"context"
+	"errors"
+	"net"
+	"testing"
+
+	wgutil "github.com/mhsanaei/3x-ui/v3/internal/util/wireguard"
+)
+
+type errDialer struct{}
+
+func (errDialer) DialContext(context.Context, string, string) (net.Conn, error) {
+	return nil, errors.New("awg test: no egress")
+}
+
+func freeUDPPort(t *testing.T) int {
+	t.Helper()
+	c, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatalf("free port: %v", err)
+	}
+	port := c.LocalAddr().(*net.UDPAddr).Port
+	_ = c.Close()
+	return port
+}
+
+func testInstance(t *testing.T, id, port int) Instance {
+	t.Helper()
+	serverPriv, _, err := wgutil.GenerateWireguardKeypair()
+	if err != nil {
+		t.Fatalf("server key: %v", err)
+	}
+	_, peerPub, err := wgutil.GenerateWireguardKeypair()
+	if err != nil {
+		t.Fatalf("peer key: %v", err)
+	}
+	inst := Instance{
+		Id:         id,
+		Tag:        "awg-test",
+		ListenPort: port,
+		SecretKey:  serverPriv,
+		Mtu:        1420,
+		Params:     GenerateParams(),
+	}
+	inst.Addresses = parseServerAddresses(nil, nil)
+	inst.Peers = []Peer{{
+		Email:      "tester",
+		PublicKey:  peerPub,
+		AllowedIPs: []string{"10.0.0.2/32"},
+		KeepAlive:  25,
+	}}
+	return inst
+}
+
+// TestManagerLifecycle stands up a real in-process AmneziaWG device (gVisor
+// netstack + amneziawg-go device + forwarder) with obfuscation params, then
+// updates peers live and tears it down. It proves the whole userspace data
+// plane assembles and runs without root; it does not exercise a real client
+// handshake (no AmneziaWG client is available in the test environment).
+func TestManagerLifecycle(t *testing.T) {
+	m := &Manager{devs: make(map[int]*managed)}
+	m.SetDialer(errDialer{})
+
+	inst := testInstance(t, 1, freeUDPPort(t))
+	if err := m.Ensure(inst); err != nil {
+		t.Fatalf("Ensure start: %v", err)
+	}
+	if len(m.devs) != 1 {
+		t.Fatalf("expected 1 running device, got %d", len(m.devs))
+	}
+
+	if got := m.CollectTraffic(); len(got) != 0 {
+		t.Fatalf("expected no traffic without a client, got %d entries", len(got))
+	}
+
+	devicePrint := m.devs[1].devicePrint
+	peersPrint := m.devs[1].peersPrint
+	_, peer2Pub, _ := wgutil.GenerateWireguardKeypair()
+	inst.Peers = append(inst.Peers, Peer{Email: "second", PublicKey: peer2Pub, AllowedIPs: []string{"10.0.0.3/32"}})
+	if err := m.Ensure(inst); err != nil {
+		t.Fatalf("Ensure live peer update: %v", err)
+	}
+	if m.devs[1].devicePrint != devicePrint {
+		t.Fatal("adding a peer must not restart the device")
+	}
+	if m.devs[1].peersPrint == peersPrint {
+		t.Fatal("peers fingerprint should have changed")
+	}
+
+	m.Reconcile(nil)
+	if len(m.devs) != 0 {
+		t.Fatalf("Reconcile(nil) should stop all devices, got %d", len(m.devs))
+	}
+
+	if err := m.Ensure(testInstance(t, 2, freeUDPPort(t))); err != nil {
+		t.Fatalf("Ensure after reconcile: %v", err)
+	}
+	m.StopAll()
+	if len(m.devs) != 0 {
+		t.Fatalf("StopAll should clear devices, got %d", len(m.devs))
+	}
+}
+
+func TestManagerReconcileStopsRemoved(t *testing.T) {
+	m := &Manager{devs: make(map[int]*managed)}
+	m.SetDialer(errDialer{})
+
+	a := testInstance(t, 10, freeUDPPort(t))
+	b := testInstance(t, 11, freeUDPPort(t))
+	m.Reconcile([]Instance{a, b})
+	if len(m.devs) != 2 {
+		t.Fatalf("expected 2 devices, got %d", len(m.devs))
+	}
+	m.Reconcile([]Instance{a})
+	if len(m.devs) != 1 {
+		t.Fatalf("expected 1 device after dropping b, got %d", len(m.devs))
+	}
+	if _, ok := m.devs[10]; !ok {
+		t.Fatal("device 10 should still be running")
+	}
+	m.StopAll()
+}
diff --git a/internal/awg/netstack.go b/internal/awg/netstack.go
new file mode 100644
index 0000000..345f246
--- /dev/null
+++ b/internal/awg/netstack.go
@@ -0,0 +1,159 @@
+package awg
+
+import (
+	"fmt"
+	"net/netip"
+	"os"
+	"syscall"
+
+	awgtun "github.com/amnezia-vpn/amneziawg-go/tun"
+	"gvisor.dev/gvisor/pkg/buffer"
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+	"gvisor.dev/gvisor/pkg/tcpip/link/channel"
+	"gvisor.dev/gvisor/pkg/tcpip/network/ipv4"
+	"gvisor.dev/gvisor/pkg/tcpip/network/ipv6"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+	"gvisor.dev/gvisor/pkg/tcpip/transport/icmp"
+	"gvisor.dev/gvisor/pkg/tcpip/transport/tcp"
+	"gvisor.dev/gvisor/pkg/tcpip/transport/udp"
+)
+
+const nicID tcpip.NICID = 1
+
+// netTun is a userspace TUN device backed by a gVisor network stack. The
+// AmneziaWG device writes decrypted client IP packets into it (Write ->
+// InjectInbound) and reads encapsulation-bound packets out of it (WriteNotify
+// -> Read). It mirrors xray-core's WireGuard netstack so the whole datapath
+// runs in-process with no kernel TUN and no root.
+type netTun struct {
+	ep             *channel.Endpoint
+	stack          *stack.Stack
+	events         chan awgtun.Event
+	notifyHandle   *channel.NotificationHandle
+	incomingPacket chan *buffer.View
+	mtu            int
+}
+
+// createNetTUN builds the gVisor stack, assigns the server's tunnel addresses
+// to the single NIC, and installs a default route for each enabled family so
+// every decrypted destination reaches the transport forwarders.
+func createNetTUN(localAddresses []netip.Addr, mtu int) (awgtun.Device, *stack.Stack, error) {
+	opts := stack.Options{
+		NetworkProtocols:   []stack.NetworkProtocolFactory{ipv4.NewProtocol, ipv6.NewProtocol},
+		TransportProtocols: []stack.TransportProtocolFactory{tcp.NewProtocol, udp.NewProtocol, icmp.NewProtocol6, icmp.NewProtocol4},
+		HandleLocal:        false,
+	}
+	dev := &netTun{
+		ep:             channel.New(1024, uint32(mtu), ""),
+		stack:          stack.New(opts),
+		events:         make(chan awgtun.Event, 10),
+		incomingPacket: make(chan *buffer.View),
+		mtu:            mtu,
+	}
+	sackEnabledOpt := tcpip.TCPSACKEnabled(true)
+	if tcpipErr := dev.stack.SetTransportProtocolOption(tcp.ProtocolNumber, &sackEnabledOpt); tcpipErr != nil {
+		return nil, nil, fmt.Errorf("awg: could not enable TCP SACK: %v", tcpipErr)
+	}
+	dev.notifyHandle = dev.ep.AddNotify(dev)
+	if tcpipErr := dev.stack.CreateNIC(nicID, dev.ep); tcpipErr != nil {
+		return nil, nil, fmt.Errorf("awg: CreateNIC: %v", tcpipErr)
+	}
+	var hasV4, hasV6 bool
+	for _, ip := range localAddresses {
+		var protoNumber tcpip.NetworkProtocolNumber
+		if ip.Is4() {
+			protoNumber = ipv4.ProtocolNumber
+		} else if ip.Is6() {
+			protoNumber = ipv6.ProtocolNumber
+		}
+		protoAddr := tcpip.ProtocolAddress{
+			Protocol:          protoNumber,
+			AddressWithPrefix: tcpip.AddrFromSlice(ip.AsSlice()).WithPrefix(),
+		}
+		if tcpipErr := dev.stack.AddProtocolAddress(nicID, protoAddr, stack.AddressProperties{}); tcpipErr != nil {
+			return nil, nil, fmt.Errorf("awg: AddProtocolAddress(%v): %v", ip, tcpipErr)
+		}
+		if ip.Is4() {
+			hasV4 = true
+		} else if ip.Is6() {
+			hasV6 = true
+		}
+	}
+	if hasV4 {
+		dev.stack.AddRoute(tcpip.Route{Destination: header.IPv4EmptySubnet, NIC: nicID})
+	}
+	if hasV6 {
+		dev.stack.AddRoute(tcpip.Route{Destination: header.IPv6EmptySubnet, NIC: nicID})
+	}
+	dev.events <- awgtun.EventUp
+	return dev, dev.stack, nil
+}
+
+func (tun *netTun) Name() (string, error) { return "awg", nil }
+
+func (tun *netTun) File() *os.File { return nil }
+
+func (tun *netTun) Events() <-chan awgtun.Event { return tun.events }
+
+func (tun *netTun) Read(buf [][]byte, sizes []int, offset int) (int, error) {
+	view, ok := <-tun.incomingPacket
+	if !ok {
+		return 0, os.ErrClosed
+	}
+	n, err := view.Read(buf[0][offset:])
+	if err != nil {
+		return 0, err
+	}
+	sizes[0] = n
+	return 1, nil
+}
+
+func (tun *netTun) Write(buf [][]byte, offset int) (int, error) {
+	for _, buf := range buf {
+		packet := buf[offset:]
+		if len(packet) == 0 {
+			continue
+		}
+		pkb := stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(packet)})
+		switch packet[0] >> 4 {
+		case 4:
+			tun.ep.InjectInbound(header.IPv4ProtocolNumber, pkb)
+		case 6:
+			tun.ep.InjectInbound(header.IPv6ProtocolNumber, pkb)
+		default:
+			pkb.DecRef()
+			return 0, syscall.EAFNOSUPPORT
+		}
+		pkb.DecRef()
+	}
+	return len(buf), nil
+}
+
+func (tun *netTun) WriteNotify() {
+	pkt := tun.ep.Read()
+	if pkt == nil {
+		return
+	}
+	view := pkt.ToView()
+	pkt.DecRef()
+	tun.incomingPacket <- view
+}
+
+func (tun *netTun) Close() error {
+	tun.stack.RemoveNIC(nicID)
+	tun.stack.Close()
+	tun.ep.RemoveNotify(tun.notifyHandle)
+	tun.ep.Close()
+	if tun.events != nil {
+		close(tun.events)
+	}
+	if tun.incomingPacket != nil {
+		close(tun.incomingPacket)
+	}
+	return nil
+}
+
+func (tun *netTun) MTU() (int, error) { return tun.mtu, nil }
+
+func (tun *netTun) BatchSize() int { return 1 }
diff --git a/internal/awg/params.go b/internal/awg/params.go
new file mode 100644
index 0000000..53700ff
--- /dev/null
+++ b/internal/awg/params.go
@@ -0,0 +1,259 @@
+package awg
+
+import (
+	"crypto/rand"
+	"encoding/binary"
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// Params holds the AmneziaWG obfuscation knobs that make the tunnel diverge
+// from a fingerprintable WireGuard flow. They must match between client and
+// server (except the junk-packet counts, which are one-way) or the handshake's
+// magic-header/length checks fail. Field names follow the AmneziaWG 2.0 scheme
+// implemented by amneziawg-go: Jc/Jmin/Jmax (junk packets), S1..S4 (message
+// paddings), H1..H4 (magic headers), I1..I5 (custom protocol-signature junk).
+type Params struct {
+	Jc   int    `json:"jc"`
+	Jmin int    `json:"jmin"`
+	Jmax int    `json:"jmax"`
+	S1   int    `json:"s1"`
+	S2   int    `json:"s2"`
+	S3   int    `json:"s3"`
+	S4   int    `json:"s4"`
+	H1   string `json:"h1"`
+	H2   string `json:"h2"`
+	H3   string `json:"h3"`
+	H4   string `json:"h4"`
+	I1   string `json:"i1"`
+	I2   string `json:"i2"`
+	I3   string `json:"i3"`
+	I4   string `json:"i4"`
+	I5   string `json:"i5"`
+}
+
+func (p Params) headers() []string { return []string{p.H1, p.H2, p.H3, p.H4} }
+
+func (p Params) iPackets() []string { return []string{p.I1, p.I2, p.I3, p.I4, p.I5} }
+
+// IsWireGuardCompatible reports whether the params carry no obfuscation, so the
+// device behaves as vanilla WireGuard and can interoperate with a stock peer.
+func (p Params) IsWireGuardCompatible() bool {
+	if p.Jc != 0 || p.Jmin != 0 || p.Jmax != 0 || p.S1 != 0 || p.S2 != 0 || p.S3 != 0 || p.S4 != 0 {
+		return false
+	}
+	for _, h := range p.headers() {
+		if strings.TrimSpace(h) != "" {
+			return false
+		}
+	}
+	for _, i := range p.iPackets() {
+		if strings.TrimSpace(i) != "" {
+			return false
+		}
+	}
+	return true
+}
+
+// Validate rejects parameter combinations amneziawg-go would reject at IpcSet
+// time, so the panel can surface a clear error before starting the device.
+func (p Params) Validate() error {
+	junkSet := p.Jc != 0 || p.Jmin != 0 || p.Jmax != 0
+	if junkSet {
+		if p.Jc <= 0 || p.Jmin <= 0 || p.Jmax <= 0 {
+			return fmt.Errorf("awg: Jc, Jmin and Jmax must all be positive when junk packets are enabled")
+		}
+		if p.Jmin > p.Jmax {
+			return fmt.Errorf("awg: Jmin (%d) must not exceed Jmax (%d)", p.Jmin, p.Jmax)
+		}
+	}
+	for name, s := range map[string]int{"S1": p.S1, "S2": p.S2, "S3": p.S3, "S4": p.S4} {
+		if s < 0 {
+			return fmt.Errorf("awg: %s must not be negative", name)
+		}
+	}
+
+	set := 0
+	values := make([]uint64, 0, 4)
+	singles := true
+	for idx, h := range p.headers() {
+		h = strings.TrimSpace(h)
+		if h == "" {
+			continue
+		}
+		set++
+		lo, hi, err := parseMagicHeader(h)
+		if err != nil {
+			return fmt.Errorf("awg: H%d: %w", idx+1, err)
+		}
+		if lo != hi {
+			singles = false
+		}
+		values = append(values, lo)
+	}
+	if set != 0 && set != 4 {
+		return fmt.Errorf("awg: set either all four magic headers (H1-H4) or none")
+	}
+	if set == 4 && singles {
+		for i := 0; i < len(values); i++ {
+			for j := i + 1; j < len(values); j++ {
+				if values[i] == values[j] {
+					return fmt.Errorf("awg: magic headers H1-H4 must be distinct")
+				}
+			}
+		}
+	}
+	return nil
+}
+
+// parseMagicHeader parses a single uint32 ("1148618200") or an inclusive range
+// ("100-200"), matching amneziawg-go's newMagicHeader.
+func parseMagicHeader(s string) (lo, hi uint64, err error) {
+	s = strings.TrimSpace(s)
+	if idx := strings.IndexByte(s, '-'); idx >= 0 {
+		lo, err = strconv.ParseUint(strings.TrimSpace(s[:idx]), 10, 32)
+		if err != nil {
+			return 0, 0, fmt.Errorf("invalid magic header range start %q", s[:idx])
+		}
+		hi, err = strconv.ParseUint(strings.TrimSpace(s[idx+1:]), 10, 32)
+		if err != nil {
+			return 0, 0, fmt.Errorf("invalid magic header range end %q", s[idx+1:])
+		}
+		if hi < lo {
+			return 0, 0, fmt.Errorf("magic header range end %d below start %d", hi, lo)
+		}
+		return lo, hi, nil
+	}
+	lo, err = strconv.ParseUint(s, 10, 32)
+	if err != nil {
+		return 0, 0, fmt.Errorf("invalid magic header %q", s)
+	}
+	return lo, lo, nil
+}
+
+// appendUAPILines writes the AmneziaWG device-level lines (lowercase keys) that
+// configure the amneziawg-go device via IpcSet. Only non-default values are
+// emitted; unset magic headers leave the device at WireGuard's 1/2/3/4.
+func (p Params) appendUAPILines(sb *strings.Builder) {
+	if p.Jc > 0 {
+		fmt.Fprintf(sb, "jc=%d\n", p.Jc)
+		fmt.Fprintf(sb, "jmin=%d\n", p.Jmin)
+		fmt.Fprintf(sb, "jmax=%d\n", p.Jmax)
+	}
+	writeInt(sb, "s1", p.S1)
+	writeInt(sb, "s2", p.S2)
+	writeInt(sb, "s3", p.S3)
+	writeInt(sb, "s4", p.S4)
+	for idx, h := range p.headers() {
+		if h = strings.TrimSpace(h); h != "" {
+			fmt.Fprintf(sb, "h%d=%s\n", idx+1, h)
+		}
+	}
+	for idx, i := range p.iPackets() {
+		if i = strings.TrimSpace(i); i != "" {
+			fmt.Fprintf(sb, "i%d=%s\n", idx+1, i)
+		}
+	}
+}
+
+// appendConfLines writes the AmneziaWG [Interface] keys (CamelCase) for a client
+// .conf; these must match the server for the handshake to complete.
+func (p Params) appendConfLines(sb *strings.Builder) {
+	if p.Jc > 0 {
+		fmt.Fprintf(sb, "Jc = %d\n", p.Jc)
+		fmt.Fprintf(sb, "Jmin = %d\n", p.Jmin)
+		fmt.Fprintf(sb, "Jmax = %d\n", p.Jmax)
+	}
+	writeConfInt(sb, "S1", p.S1)
+	writeConfInt(sb, "S2", p.S2)
+	writeConfInt(sb, "S3", p.S3)
+	writeConfInt(sb, "S4", p.S4)
+	names := []string{"H1", "H2", "H3", "H4"}
+	for idx, h := range p.headers() {
+		if h = strings.TrimSpace(h); h != "" {
+			fmt.Fprintf(sb, "%s = %s\n", names[idx], h)
+		}
+	}
+	iNames := []string{"I1", "I2", "I3", "I4", "I5"}
+	for idx, i := range p.iPackets() {
+		if i = strings.TrimSpace(i); i != "" {
+			fmt.Fprintf(sb, "%s = %s\n", iNames[idx], i)
+		}
+	}
+}
+
+func writeInt(sb *strings.Builder, key string, v int) {
+	if v > 0 {
+		fmt.Fprintf(sb, "%s=%d\n", key, v)
+	}
+}
+
+func writeConfInt(sb *strings.Builder, key string, v int) {
+	if v > 0 {
+		fmt.Fprintf(sb, "%s = %d\n", key, v)
+	}
+}
+
+// fingerprint is a stable string of every param value; the manager restarts a
+// device only when this changes.
+func (p Params) fingerprint() string {
+	return strings.Join([]string{
+		strconv.Itoa(p.Jc), strconv.Itoa(p.Jmin), strconv.Itoa(p.Jmax),
+		strconv.Itoa(p.S1), strconv.Itoa(p.S2), strconv.Itoa(p.S3), strconv.Itoa(p.S4),
+		p.H1, p.H2, p.H3, p.H4, p.I1, p.I2, p.I3, p.I4, p.I5,
+	}, "|")
+}
+
+// GenerateParams returns a randomized obfuscating parameter set suitable as the
+// default for a new AmneziaWG inbound: a handful of junk packets, small init and
+// response paddings, and four distinct magic headers well above WireGuard's
+// reserved 1-4 message types.
+func GenerateParams() Params {
+	jmin := 40 + randInt(50)
+	p := Params{
+		Jc:   3 + randInt(8),
+		Jmin: jmin,
+		Jmax: jmin + 20 + randInt(80),
+		S1:   15 + randInt(80),
+		S2:   15 + randInt(80),
+	}
+	headers := randomHeaders()
+	p.H1, p.H2, p.H3, p.H4 = headers[0], headers[1], headers[2], headers[3]
+	return p
+}
+
+// randomHeaders returns four distinct uint32 magic headers, each above 4 so they
+// never collide with WireGuard's reserved message-type bytes.
+func randomHeaders() [4]string {
+	var out [4]string
+	seen := make(map[uint32]struct{}, 4)
+	for i := 0; i < 4; {
+		v := randUint32()
+		if v <= 4 {
+			continue
+		}
+		if _, dup := seen[v]; dup {
+			continue
+		}
+		seen[v] = struct{}{}
+		out[i] = strconv.FormatUint(uint64(v), 10)
+		i++
+	}
+	return out
+}
+
+func randInt(n int) int {
+	if n <= 0 {
+		return 0
+	}
+	return int(randUint32() % uint32(n))
+}
+
+func randUint32() uint32 {
+	var b [4]byte
+	if _, err := rand.Read(b[:]); err != nil {
+		return 0
+	}
+	return binary.BigEndian.Uint32(b[:])
+}
diff --git a/internal/awg/params_test.go b/internal/awg/params_test.go
new file mode 100644
index 0000000..e4c13cf
--- /dev/null
+++ b/internal/awg/params_test.go
@@ -0,0 +1,154 @@
+package awg
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestParamsValidate(t *testing.T) {
+	tests := []struct {
+		name    string
+		params  Params
+		wantErr string
+	}{
+		{
+			name:   "empty is wireguard compatible",
+			params: Params{},
+		},
+		{
+			name:   "full obfuscation valid",
+			params: Params{Jc: 4, Jmin: 40, Jmax: 70, S1: 30, S2: 40, H1: "10", H2: "20", H3: "30", H4: "40"},
+		},
+		{
+			name:    "junk half set",
+			params:  Params{Jc: 4, Jmin: 0, Jmax: 70},
+			wantErr: "must all be positive",
+		},
+		{
+			name:    "jmin above jmax",
+			params:  Params{Jc: 4, Jmin: 80, Jmax: 70},
+			wantErr: "must not exceed",
+		},
+		{
+			name:    "negative padding",
+			params:  Params{S1: -1},
+			wantErr: "must not be negative",
+		},
+		{
+			name:    "three headers set",
+			params:  Params{H1: "10", H2: "20", H3: "30"},
+			wantErr: "all four magic headers",
+		},
+		{
+			name:    "duplicate headers",
+			params:  Params{H1: "10", H2: "10", H3: "30", H4: "40"},
+			wantErr: "must be distinct",
+		},
+		{
+			name:   "header ranges valid",
+			params: Params{H1: "100-200", H2: "300-400", H3: "500-600", H4: "700-800"},
+		},
+		{
+			name:    "bad header value",
+			params:  Params{H1: "abc", H2: "20", H3: "30", H4: "40"},
+			wantErr: "invalid magic header",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := tt.params.Validate()
+			if tt.wantErr == "" {
+				if err != nil {
+					t.Fatalf("Validate() = %v, want nil", err)
+				}
+				return
+			}
+			if err == nil || !strings.Contains(err.Error(), tt.wantErr) {
+				t.Fatalf("Validate() = %v, want error containing %q", err, tt.wantErr)
+			}
+		})
+	}
+}
+
+func TestIsWireGuardCompatible(t *testing.T) {
+	if !(Params{}).IsWireGuardCompatible() {
+		t.Fatal("empty params should be wireguard compatible")
+	}
+	if (Params{Jc: 1, Jmin: 1, Jmax: 2}).IsWireGuardCompatible() {
+		t.Fatal("junk params should not be wireguard compatible")
+	}
+	if (Params{H1: "10", H2: "20", H3: "30", H4: "40"}).IsWireGuardCompatible() {
+		t.Fatal("magic headers should not be wireguard compatible")
+	}
+	if (Params{I1: "<b 0x00>"}).IsWireGuardCompatible() {
+		t.Fatal("i-packets should not be wireguard compatible")
+	}
+}
+
+func TestGenerateParamsIsValidAndObfuscating(t *testing.T) {
+	for i := 0; i < 50; i++ {
+		p := GenerateParams()
+		if err := p.Validate(); err != nil {
+			t.Fatalf("GenerateParams() produced invalid params: %v (%+v)", err, p)
+		}
+		if p.IsWireGuardCompatible() {
+			t.Fatalf("GenerateParams() should produce obfuscating params, got %+v", p)
+		}
+		if p.Jmin > p.Jmax {
+			t.Fatalf("Jmin %d > Jmax %d", p.Jmin, p.Jmax)
+		}
+	}
+}
+
+func TestAppendUAPILines(t *testing.T) {
+	p := Params{Jc: 4, Jmin: 40, Jmax: 70, S1: 30, S2: 40, H1: "10", H2: "20", H3: "30", H4: "40", I1: "<b 0x01>"}
+	var sb strings.Builder
+	p.appendUAPILines(&sb)
+	got := sb.String()
+	for _, want := range []string{"jc=4\n", "jmin=40\n", "jmax=70\n", "s1=30\n", "s2=40\n", "h1=10\n", "h4=40\n", "i1=<b 0x01>\n"} {
+		if !strings.Contains(got, want) {
+			t.Fatalf("uapi lines missing %q in:\n%s", want, got)
+		}
+	}
+	if strings.Contains(got, "s3=") || strings.Contains(got, "i2=") {
+		t.Fatalf("unset params should be omitted, got:\n%s", got)
+	}
+}
+
+func TestAppendConfLinesCamelCase(t *testing.T) {
+	p := Params{Jc: 4, Jmin: 40, Jmax: 70, S1: 30, H1: "10", H2: "20", H3: "30", H4: "40"}
+	var sb strings.Builder
+	p.appendConfLines(&sb)
+	got := sb.String()
+	for _, want := range []string{"Jc = 4\n", "Jmin = 40\n", "S1 = 30\n", "H1 = 10\n", "H4 = 40\n"} {
+		if !strings.Contains(got, want) {
+			t.Fatalf("conf lines missing %q in:\n%s", want, got)
+		}
+	}
+}
+
+func TestParseMagicHeader(t *testing.T) {
+	tests := []struct {
+		in      string
+		lo, hi  uint64
+		wantErr bool
+	}{
+		{in: "1148618200", lo: 1148618200, hi: 1148618200},
+		{in: "100-200", lo: 100, hi: 200},
+		{in: "200-100", wantErr: true},
+		{in: "abc", wantErr: true},
+		{in: "5000000000", wantErr: true},
+	}
+	for _, tt := range tests {
+		lo, hi, err := parseMagicHeader(tt.in)
+		if tt.wantErr {
+			if err == nil {
+				t.Fatalf("parseMagicHeader(%q) = nil error, want error", tt.in)
+			}
+			continue
+		}
+		if err != nil || lo != tt.lo || hi != tt.hi {
+			t.Fatalf("parseMagicHeader(%q) = (%d,%d,%v), want (%d,%d,nil)", tt.in, lo, hi, err, tt.lo, tt.hi)
+		}
+	}
+}
