diff --git a/frontend/src/lib/xray/awg.ts b/frontend/src/lib/xray/awg.ts
new file mode 100644
index 0000000..9ab1bb0
--- /dev/null
+++ b/frontend/src/lib/xray/awg.ts
@@ -0,0 +1,157 @@
+import { RandomUtil } from '@/utils';
+
+// Shared helpers for AmneziaWG obfuscation parameters — the `awg` object on an
+// amneziawg inbound and the raw `awgParams` JSON the clients page consumes.
+// Keeps the client .conf emit rules and the randomizer in one place so the
+// form, the inbound defaults, and both config generators stay in lockstep.
+
+// jc/jmin/jmax/s1-s4 are numbers (0 = off); h1-h4/i1-i5 are strings (a uint32
+// or an "x-y" magic-header range, or an optional CPS junk tag). Fields are read
+// defensively so a raw backend JSON object (numbers/strings) coerces cleanly.
+export interface AwgParamsLike {
+  jc?: number;
+  jmin?: number;
+  jmax?: number;
+  s1?: number;
+  s2?: number;
+  s3?: number;
+  s4?: number;
+  h1?: string;
+  h2?: string;
+  h3?: string;
+  h4?: string;
+  i1?: string;
+  i2?: string;
+  i3?: string;
+  i4?: string;
+  i5?: string;
+}
+
+function num(v: unknown): number {
+  return typeof v === 'number' && Number.isFinite(v) ? v : Number(v) || 0;
+}
+
+function str(v: unknown): string {
+  if (typeof v === 'string') return v.trim();
+  return v == null ? '' : String(v).trim();
+}
+
+// Emit the AmneziaWG [Interface] keys (CamelCase) for a client .conf, matching
+// the Go awg.Params.appendConfLines rules exactly: Jc/Jmin/Jmax only when jc>0;
+// S1..S4 only when >0; H1..H4/I1..I5 only when the string is non-empty. The
+// values must match the server for the handshake to complete.
+export function formatAwgInterfaceLines(params: AwgParamsLike | null | undefined): string[] {
+  if (!params) return [];
+  const lines: string[] = [];
+  const jc = num(params.jc);
+  if (jc > 0) {
+    lines.push(`Jc = ${jc}`);
+    lines.push(`Jmin = ${num(params.jmin)}`);
+    lines.push(`Jmax = ${num(params.jmax)}`);
+  }
+  const sVals: [string, number][] = [
+    ['S1', num(params.s1)],
+    ['S2', num(params.s2)],
+    ['S3', num(params.s3)],
+    ['S4', num(params.s4)],
+  ];
+  for (const [key, v] of sVals) {
+    if (v > 0) lines.push(`${key} = ${v}`);
+  }
+  const hVals: [string, string][] = [
+    ['H1', str(params.h1)],
+    ['H2', str(params.h2)],
+    ['H3', str(params.h3)],
+    ['H4', str(params.h4)],
+  ];
+  for (const [key, v] of hVals) {
+    if (v !== '') lines.push(`${key} = ${v}`);
+  }
+  const iVals: [string, string][] = [
+    ['I1', str(params.i1)],
+    ['I2', str(params.i2)],
+    ['I3', str(params.i3)],
+    ['I4', str(params.i4)],
+    ['I5', str(params.i5)],
+  ];
+  for (const [key, v] of iVals) {
+    if (v !== '') lines.push(`${key} = ${v}`);
+  }
+  return lines;
+}
+
+// Parse the raw `awgParams` JSON string carried on the clients-page
+// InboundOption into an AwgParamsLike. Returns null when absent or unparseable.
+export function parseAwgParams(raw: string | null | undefined): AwgParamsLike | null {
+  if (!raw || raw.trim() === '') return null;
+  try {
+    const parsed = JSON.parse(raw);
+    return parsed && typeof parsed === 'object' && !Array.isArray(parsed)
+      ? (parsed as AwgParamsLike)
+      : null;
+  } catch {
+    return null;
+  }
+}
+
+// A fully-populated awg object suitable as the default for a new AmneziaWG
+// inbound and as the value the form's Randomize button writes.
+export interface AwgRandomParams {
+  jc: number;
+  jmin: number;
+  jmax: number;
+  s1: number;
+  s2: number;
+  s3: number;
+  s4: number;
+  h1: string;
+  h2: string;
+  h3: string;
+  h4: string;
+  i1: string;
+  i2: string;
+  i3: string;
+  i4: string;
+  i5: string;
+}
+
+// Randomized obfuscating parameters mirroring the Go awg.GenerateParams: a
+// handful of junk packets, small init/response paddings, and four distinct
+// magic headers well above WireGuard's reserved 1-4 message types. S3/S4 and
+// I1-I5 stay 0/'' (rarely used, and omitted from the emitted .conf).
+export function randomizeAwgParams(): AwgRandomParams {
+  const jmin = RandomUtil.randomInteger(40, 89);
+  const [h1, h2, h3, h4] = randomDistinctHeaders();
+  return {
+    jc: RandomUtil.randomInteger(3, 10),
+    jmin,
+    jmax: jmin + 20 + RandomUtil.randomInteger(0, 80),
+    s1: RandomUtil.randomInteger(15, 150),
+    s2: RandomUtil.randomInteger(15, 150),
+    s3: 0,
+    s4: 0,
+    h1,
+    h2,
+    h3,
+    h4,
+    i1: '',
+    i2: '',
+    i3: '',
+    i4: '',
+    i5: '',
+  };
+}
+
+// Four distinct uint32 magic headers, each above 4 so they never collide with
+// WireGuard's reserved message-type bytes.
+function randomDistinctHeaders(): [string, string, string, string] {
+  const seen = new Set<number>();
+  const out: string[] = [];
+  while (out.length < 4) {
+    const v = RandomUtil.randomInteger(5, 4294967295);
+    if (seen.has(v)) continue;
+    seen.add(v);
+    out.push(String(v));
+  }
+  return [out[0], out[1], out[2], out[3]];
+}
